{
  "name": "usamas-taxi-dispatcher",
  "private": true,
  "version": "1.0.0",
  "description": "Voice AI taxi dispatcher (English / Urdu) on Cloudflare Workers AI + D1",
  "scripts": {
    "build:ui": "npm --prefix ui install && npm --prefix ui run build",
    "build": "npm run build:ui",
    "dev": "npm run build && wrangler dev",
    "db:migrate": "wrangler d1 migrations apply taxi_bookings --remote",
    "db:migrate:local": "wrangler d1 migrations apply taxi_bookings --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
